# --- Application -----------------------------------------------------------
TZ=Europe/Paris
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
SESSION_DRIVER=cookie

# Signs cookies and sessions. Generate with: node ace generate:key
APP_KEY=

# --- Database --------------------------------------------------------------
# Must live on the persistent volume, or a redeploy empties the fridge.
DB_PATH=/app/storage/db.sqlite3

# --- Authentication --------------------------------------------------------
# Single password, no accounts table. Generate with: node ace password:hash "…"
# In a .env file every "$" of the scrypt digest must be escaped as "\$", or
# dotenv expands it away and no password ever matches. The command prints both
# forms; paste the unescaped one into Coolify's environment variables UI and
# enable its "Literal" option so Coolify does not interpolate the "$" signs.
APP_PASSWORD_HASH=
# Temporary test-only bypass. Set back to false before opening the app to others.
AUTH_DISABLED=false

# --- Open Food Facts -------------------------------------------------------
# The API filters generic user agents. Format: AppName/Version (contact@email)
OFF_USER_AGENT=MyFrigo/1.0 (deuleydamien@gmail.com)
# Staging instance for testing: https://world.openfoodfacts.net (basic auth off/off)
OFF_BASE_URL=https://world.openfoodfacts.org

# --- Web Push --------------------------------------------------------------
# Generate with: node ace push:keys — leave empty to run without notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deuleydamien@gmail.com
